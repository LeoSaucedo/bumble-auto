# BumbleAuto — ⚠️ fill in at least one API key

# Anthropic (JUDGE_BACKEND=anthropic) — best quality
ANTHROPIC_API_KEY=***

# Gemini (JUDGE_BACKEND=gemini) — cheap, good quality
GEMINI_API_KEY=***

# DeepSeek (JUDGE_BACKEND=deepseek) — cheap vision backend
DEEPSEEK_API_KEY=***

# Discord webhook for session reports (optional)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# Mode selection
ACTIVE_MODE=carlos

# Judge settings
# Backends: anthropic | gemini | deepseek | ollama
JUDGE_BACKEND=gemini
# Gemini flash options (input/output per 1M tokens, Sept 2026 rates):
#   gemini-3.5-flash-lite  $0.30 / $2.50   <- cheapest current vision model
#   gemini-3.1-flash-lite  $0.25 / $1.50   <- older, still cheapest on paper
#   gemini-3.6-flash       $0.75 / $3.75
#   gemini-3.7-flash       $0.75 / $3.75
#   gemini-3.8-flash       $0.75 / $3.75   <- most intelligent; doubles 2027-01-01
#   gemini-3.5-flash       $1.50 / $9.00
GEMINI_MODEL=gemini-3.5-flash-lite
# DeepSeek vision model: deepseek-flash (deepseek-v4-pro has no vision)
# DEEPSEEK_MODEL=deepseek-flash
# DEEPSEEK_THINKING=false

# Session limits
MAX_LIKES_PER_SESSION=20
SESSION_LIKE_MIN=0

# Run mode
DRY_RUN=false
