# BumbleAuto — ⚠️ fill in at least one API key

# Anthropic (JUDGE_BACKEND=anthropic) — best quality
ANTHROPIC_API_KEY=***

# Gemini (JUDGE_BACKEND=gemini) — cheap, good quality
GEMINI_API_KEY=***

# DeepSeek (JUDGE_BACKEND=deepseek) — cheap vision backend
DEEPSEEK_API_KEY=***

# Discord webhook for session reports (optional)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# Mode selection
ACTIVE_MODE=carlos

# Judge settings
# Backends: anthropic | gemini | deepseek | ollama
JUDGE_BACKEND=gemini
# Gemini flash options: gemini-3.1-flash-lite (cheapest), gemini-3.5-flash,
# gemini-3.6-flash, gemini-3.8-flash (most intelligent)
GEMINI_MODEL=gemini-3.1-flash-lite
# DeepSeek vision model: deepseek-flash (deepseek-v4-pro has no vision)
# DEEPSEEK_MODEL=deepseek-flash
# DEEPSEEK_THINKING=false

# Session limits
MAX_LIKES_PER_SESSION=20
SESSION_LIKE_MIN=0

# Run mode
DRY_RUN=false
