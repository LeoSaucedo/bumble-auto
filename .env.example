# BumbleAuto — ⚠️ fill in at least one API key

# Anthropic (JUDGE_BACKEND=anthropic) — best quality
ANTHROPIC_API_KEY=***

# Gemini (JUDGE_BACKEND=gemini) — cheap, good quality
GEMINI_API_KEY=***

# DeepSeek (JUDGE_BACKEND=deepseek) — cheap vision backend
DEEPSEEK_API_KEY=***

# Discord webhook for session reports (optional)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# Mode selection
ACTIVE_MODE=carlos

# Judge settings
# Backends: anthropic | gemini | deepseek | ollama
JUDGE_BACKEND=gemini
# Gemini flash options (input/output per 1M tokens, Sept 2026 rates):
#   gemini-3.5-flash-lite  $0.30 / $2.50   <- cheapest current vision model
#   gemini-3.1-flash-lite  $0.25 / $1.50   <- older, still cheapest on paper
#   gemini-3.6-flash       $0.75 / $3.75
#   gemini-3.7-flash       $0.75 / $3.75
#   gemini-3.8-flash       $0.75 / $3.75   <- most intelligent; doubles 2027-01-01
#   gemini-3.5-flash       $1.50 / $9.00
GEMINI_MODEL=gemini-3.5-flash-lite
# DeepSeek vision model: deepseek-flash (deepseek-v4-pro has no vision)
# DEEPSEEK_MODEL=deepseek-flash
# DEEPSEEK_THINKING=false

# Session limits
MAX_LIKES_PER_SESSION=20
SESSION_LIKE_MIN=0

# Pickiness: the judge scores each profile 0-100 and never picks like/skip
# itself. The harness likes iff fit_score >= FIT_SCORE_MIN, else skips.
# Raise to be pickier, lower for more volume.
FIT_SCORE_MIN=50

# Run mode
DRY_RUN=false

# Where captured frames and per-profile decisions are written. Absolute, or
# relative to the repo root. Every profile saves ~7 PNGs, so this grows to
# gigabytes — point it at a bigger disk than the repo if you have one.
# DEBUG_DIR=/mnt/bigdisk/bumble-auto/debug

# ---------- Device ----------
# The shipped defaults are 720x1600. Set these if you're running a different
# phone or emulator. Every value in COORDS is a raw pixel on THIS screen, so
# a different size means recalibrating the whole table.
# SCREEN_WIDTH=720
# SCREEN_HEIGHT=1600

# Coordinate table, as JSON. Merged key-by-key over the defaults in
# config.py, so list only the keys you want to move — everything you leave
# out keeps its shipped value. Get the numbers from `python calibrate.py`.
# COORDS='{"skip_button": [126, 998], "like_button": [595, 1000]}'
